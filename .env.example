# Database & Security
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/foreclosure_db
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256

# Local Ollama LLM Configuration
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=60

# Semantic Embeddings Configuration
# Set to 'nomic-embed-text' (pull with: ollama pull nomic-embed-text)
# When set, uses Ollama /api/embed with search_document: & search_query: task prefixes.
# If left empty or Ollama is offline, automatically uses stable feature-hashed vectors.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Fast Cloud LLM Provider (Optional)
# If GEMINI_API_KEY is set, the chatbot uses Gemini for sub-400ms analysis generation.
# If omitted or empty, it automatically routes to local Ollama (OLLAMA_MODEL).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
